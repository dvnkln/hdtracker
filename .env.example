# Copy to .env and fill in. Only secrets live here; everything else is configured in the app.

# Random string (min. 32 chars) used to sign sessions.
# How to: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (or: openssl rand -hex 32)
SECRET=

# How to: themoviedb.org -> Settings -> API -> copy the long "API Read Access Token" (not the short API key).
TMDB_API_TOKEN=

# How to: dev.twitch.tv/console/apps -> Register Your Application (OAuth Redirect URL: http://localhost,
# Category: Application Integration, Client Type: Confidential) -> copy Client ID -> "New Secret" for the secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Timezone, e.g. Europe/Berlin (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Berlin

# The exact address you open the app with (protocol + host + port, no trailing slash). Login fails if it does not match.
# How to: http://localhost:3000 (same PC), http://192.168.1.50:3000 (LAN / phone), https://tracker.example.com (reverse proxy)
ORIGIN=http://localhost:3000
