# Copy to .env and fill in. Only secrets live here; everything else is configured in the app.

# Random string (min. 32 chars) used to sign sessions. Generate e.g. with: openssl rand -hex 32
SECRET=

# https://www.themoviedb.org/settings/api -> "API Read Access Token" (long token, not the short API key)
TMDB_API_TOKEN=

# https://dev.twitch.tv/console/apps (IGDB uses Twitch OAuth)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Timezone, e.g. Europe/Berlin
TZ=Europe/Berlin
